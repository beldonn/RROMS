@page "/Error"
@model RROMS.Pages.Shared.ErrorModel
@{
    ViewData["Title"] = "Error";
}
<div class="rroms-card p-5 text-center my-5">
    <h1 class="display-font mb-3">Something went wrong</h1>
    <p class="text-muted-warm">An unexpected error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted-warm">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index" class="btn btn-primary mt-2">Back to Home</a>
</div>
