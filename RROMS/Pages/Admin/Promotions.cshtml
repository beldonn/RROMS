@page
@model RROMS.Pages.Admin.PromotionsModel
@{
    ViewData["Title"] = "Promotions";
}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="h3 mb-0">Promotional Campaigns</h1>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPromoModal"><i class="bi bi-plus-lg"></i> New promotion</button>
</div>

<div class="rroms-card p-2">
    <table class="table rroms-table mb-0 align-middle">
        <thead><tr><th>Title</th><th>Applies to</th><th>Discount</th><th>Dates</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in Model.Promotions)
            {
                <tr>
                    <td>@p.Title<div class="small text-muted-warm">@p.Description</div></td>
                    <td>@(p.MenuItem?.Name ?? "Storewide")</td>
                    <td>@p.DiscountPercent%</td>
                    <td class="small">@p.StartDate.ToString("dd MMM yyyy") &ndash; @p.EndDate.ToString("dd MMM yyyy")</td>
                    <td><span class="status-badge @(p.IsCurrentlyRunning ? "status-confirmed" : "status-cancelled")">@(p.IsCurrentlyRunning ? "Running" : p.IsActive ? "Scheduled/Ended" : "Inactive")</span></td>
                    <td class="text-nowrap">
                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editPromoModal"
                                data-edit-modal="editPromoModal" data-fields="id,title,description,discountpercent,menuitemid,startdate,enddate,isactive"
                                data-id="@p.Id" data-title="@p.Title" data-description="@p.Description" data-discountpercent="@p.DiscountPercent"
                                data-menuitemid="@p.MenuItemId" data-startdate="@p.StartDate.ToString("yyyy-MM-dd")" data-enddate="@p.EndDate.ToString("yyyy-MM-dd")"
                                data-isactive="@p.IsActive.ToString().ToLower()">Edit</button>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" class="d-inline" onsubmit="return confirm('Delete this promotion?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Add Promotion Modal -->
<div class="modal fade" id="addPromoModal"><div class="modal-dialog modal-lg"><div class="modal-content">
    <form method="post" asp-page-handler="Add">
        <div class="modal-header"><h5 class="modal-title">New promotion</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body row g-2">
            <div class="col-md-6"><label class="form-label">Title</label><input name="title" class="form-control" required /></div>
            <div class="col-md-3"><label class="form-label">Discount %</label><input type="number" step="0.5" min="1" max="100" name="discountPercent" class="form-control" required /></div>
            <div class="col-md-3">
                <label class="form-label">Applies to</label>
                <select name="menuItemId" class="form-select"><option value="">Storewide</option>@foreach (var m in Model.MenuItems) { <option value="@m.Id">@m.Name</option> }</select>
            </div>
            <div class="col-12"><label class="form-label">Description</label><textarea name="description" class="form-control"></textarea></div>
            <div class="col-md-6"><label class="form-label">Start date</label><input type="date" name="startDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required /></div>
            <div class="col-md-6"><label class="form-label">End date</label><input type="date" name="endDate" value="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")" class="form-control" required /></div>
            <div class="col-12 form-check"><input type="checkbox" name="notifyCustomers" value="true" class="form-check-input" id="notifyCustomers" checked /><label class="form-check-label" for="notifyCustomers">Notify all customers</label></div>
        </div>
        <div class="modal-footer"><button type="submit" class="btn btn-primary">Create</button></div>
    </form>
</div></div></div>

<!-- Edit Promotion Modal -->
<div class="modal fade" id="editPromoModal"><div class="modal-dialog modal-lg"><div class="modal-content">
    <form method="post" asp-page-handler="Edit">
        <div class="modal-header"><h5 class="modal-title">Edit promotion</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body row g-2">
            <input type="hidden" name="id" id="editPromoModal_id" />
            <div class="col-md-6"><label class="form-label">Title</label><input name="title" id="editPromoModal_title" class="form-control" required /></div>
            <div class="col-md-3"><label class="form-label">Discount %</label><input type="number" step="0.5" min="1" max="100" name="discountPercent" id="editPromoModal_discountpercent" class="form-control" required /></div>
            <div class="col-md-3">
                <label class="form-label">Applies to</label>
                <select name="menuItemId" id="editPromoModal_menuitemid" class="form-select"><option value="">Storewide</option>@foreach (var m in Model.MenuItems) { <option value="@m.Id">@m.Name</option> }</select>
            </div>
            <div class="col-12"><label class="form-label">Description</label><textarea name="description" id="editPromoModal_description" class="form-control"></textarea></div>
            <div class="col-md-6"><label class="form-label">Start date</label><input type="date" name="startDate" id="editPromoModal_startdate" class="form-control" required /></div>
            <div class="col-md-6"><label class="form-label">End date</label><input type="date" name="endDate" id="editPromoModal_enddate" class="form-control" required /></div>
            <div class="col-12 form-check"><input type="checkbox" name="isActive" value="true" id="editPromoModal_isactive" class="form-check-input" /><label class="form-check-label">Active</label></div>
        </div>
        <div class="modal-footer"><button type="submit" class="btn btn-primary">Save</button></div>
    </form>
</div></div></div>
