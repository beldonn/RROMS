@page
@model RROMS.Pages.Staff.BillingModel
@{
    ViewData["Title"] = "Billing";
}
<h1 class="h3 mb-4">Billing</h1>

<div class="rroms-card p-3 mb-4">
    <form method="get" class="d-flex gap-2">
        <input type="number" name="SearchOrderId" value="@Model.SearchOrderId" class="form-control" placeholder="Look up order # to bill" style="max-width:260px;" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </form>
    @if (Model.SearchOrderId.HasValue)
    {
        @if (Model.SearchResult == null)
        {
            <p class="text-muted-warm mt-2 mb-0">No order found with that number.</p>
        }
        else
        {
            var o = Model.SearchResult;
            <div class="mt-3">
                <strong>Order #@o.Id</strong> &middot; @o.Customer?.FullName &middot; Total @o.TotalAmount.ToString("C")
                &middot; Payment: <span class="status-badge status-@o.Payment?.Status.ToString().ToLower()">@(o.Payment?.Status.ToString() ?? "none")</span>
                @if (o.Payment != null && o.Payment.Status == PaymentStatus.Pending)
                {
                    <form method="post" asp-page-handler="RecordPayment" class="d-inline ms-2">
                        <input type="hidden" name="orderId" value="@o.Id" />
                        <select name="method" class="form-select form-select-sm d-inline-block" style="width:auto;">
                            <option value="0">Cash</option>
                            <option value="1">Card</option>
                            <option value="2">Online payment</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-herb">Record payment</button>
                    </form>
                }
            </div>
        }
    }
</div>

<h2 class="h5 mb-3">Orders awaiting payment</h2>
@if (!Model.PendingPaymentOrders.Any())
{
    <div class="rroms-card p-4 text-center text-muted-warm">Nothing outstanding.</div>
}
else
{
    <div class="table-responsive rroms-card p-2">
        <table class="table rroms-table mb-0 align-middle">
            <thead><tr><th>Order #</th><th>Customer</th><th>Items</th><th>Total</th><th></th></tr></thead>
            <tbody>
                @foreach (var o in Model.PendingPaymentOrders)
                {
                    <tr>
                        <td>#@o.Id</td>
                        <td>@o.Customer?.FullName</td>
                        <td>@o.OrderItems.Sum(i => i.Quantity) item(s)</td>
                        <td>@o.TotalAmount.ToString("C")</td>
                        <td>
                            <form method="post" asp-page-handler="RecordPayment" class="d-flex gap-1">
                                <input type="hidden" name="orderId" value="@o.Id" />
                                <select name="method" class="form-select form-select-sm">
                                    <option value="0">Cash</option>
                                    <option value="1">Card</option>
                                    <option value="2">Online payment</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-herb">Mark paid</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
