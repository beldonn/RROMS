@page
@model RROMS.Pages.Staff.OrdersModel
@{
    ViewData["Title"] = "Manage Orders";

    string NextStatusLabel(OrderStatus s) => s switch
    {
        OrderStatus.Placed => "Start preparing",
        OrderStatus.Preparing => "Mark ready",
        OrderStatus.ReadyToServe => "Mark served",
        OrderStatus.Served => "Complete order",
        _ => "Advance"
    };
    OrderStatus NextStatus(OrderStatus s) => s switch
    {
        OrderStatus.Placed => OrderStatus.Preparing,
        OrderStatus.Preparing => OrderStatus.ReadyToServe,
        OrderStatus.ReadyToServe => OrderStatus.Served,
        OrderStatus.Served => OrderStatus.Completed,
        _ => s
    };
}
<h1 class="h3 mb-4">Manage Orders</h1>

@if (!Model.Orders.Any())
{
    <div class="rroms-card p-5 text-center text-muted-warm">No active orders right now.</div>
}
else
{
    <div class="row g-3">
        @foreach (var o in Model.Orders)
        {
            <div class="col-md-6 col-lg-4">
                <div class="rroms-card p-3">
                    <div class="d-flex justify-content-between">
                        <strong>Order #@o.Id</strong>
                        <span class="status-badge status-@o.Status.ToString().ToLower()">@o.Status</span>
                    </div>
                    <div class="small text-muted-warm mb-2">@o.Customer?.FullName &middot; @o.OrderType @(o.Table != null ? $"· Table {o.Table.TableNumber}" : "")</div>
                    <ul class="small mb-2 ps-3">
                        @foreach (var item in o.OrderItems)
                        {
                            <li>@item.Quantity &times; @item.ItemNameSnapshot</li>
                        }
                    </ul>
                    <div class="d-flex justify-content-between small mb-2">
                        <span>Total</span><span class="fw-semibold">@o.TotalAmount.ToString("C")</span>
                    </div>
                    <div class="d-flex gap-2">
                        <form method="post" asp-page-handler="AdvanceStatus" asp-route-id="@o.Id" asp-route-newStatus="@NextStatus(o.Status)" class="flex-grow-1">
                            <button type="submit" class="btn btn-sm btn-herb w-100">@NextStatusLabel(o.Status)</button>
                        </form>
                        @if (o.Status == OrderStatus.Placed)
                        {
                            <form method="post" asp-page-handler="Cancel" asp-route-id="@o.Id" onsubmit="return confirm('Cancel this order?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
